generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model Merchant {
  id          String       @id
  name        String
  enabled     Boolean      @default(true)
  branches    Branch[]
  memberships Membership[]

  @@schema("app")
}

model Branch {
  id          String         @id
  merchantId  String
  name        String
  enabled     Boolean        @default(true)
  latitude    Float
  longitude   Float
  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  quotes      PricingQuote[]
  deliveries  Delivery[]
  privateLocations PrivateLocationEnvelope[]

  @@unique([id, merchantId])
  @@index([merchantId])
  @@schema("app")
}

model Membership {
  id         String   @id
  subjectId  String   @db.Uuid
  merchantId String
  branchId   String
  enabled    Boolean  @default(true)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch     Branch   @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([subjectId, branchId])
  @@index([branchId, merchantId])
  @@index([merchantId])
  @@schema("app")
}

model PricingQuote {
  id                  String    @id
  subjectId           String    @db.Uuid
  merchantId          String
  branchId            String
  request             Json
  amountMinor         Int
  baseAmountMinor     Int
  distanceAmountMinor Int
  currency            String    @default("MXN")
  expiresAt           DateTime  @db.Timestamptz(3)
  rateVersion         String
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  branch              Branch    @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  delivery            Delivery?

  @@unique([id, branchId, merchantId])
  @@index([branchId, merchantId, createdAt])
  @@index([subjectId])
  @@schema("app")
}

model Delivery {
  id                  String       @id @default(uuid())
  subjectId           String       @db.Uuid
  merchantId          String
  branchId            String
  quoteId             String       @unique
  status              String       @default("requested")
  version             Int          @default(1)
  amountMinor         Int
  baseAmountMinor     Int
  distanceAmountMinor Int
  currency            String
  rateVersion         String
  routeSnapshot       Json
  idempotencyKeyHash  String       @db.Char(64)
  requestHash         String       @db.Char(64)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  branch              Branch       @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  quote               PricingQuote @relation(fields: [quoteId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)

  @@unique([subjectId, branchId, idempotencyKeyHash])
  @@unique([quoteId, branchId, merchantId])
  @@index([branchId, merchantId, createdAt])
  @@schema("app")
}

model PrivateLocationEnvelope {
  id             String   @id @db.Uuid
  subjectId      String   @db.Uuid
  merchantId     String
  branchId       String
  requestId      String   @db.Uuid
  version        Int      @default(1)
  policyId       String
  expiresAt      DateTime @db.Timestamptz(3)
  keyRef         String   @unique @db.Uuid
  iv             Bytes
  tag            Bytes
  ciphertext     Bytes
  state          String   @default("active")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  keyDestroyedAt DateTime? @db.Timestamptz(3)
  branch         Branch   @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([subjectId, branchId, requestId])
  @@index([branchId, merchantId])
  @@schema("app")
}
