generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model Courier {
  id        String @id
  subjectId String @unique @db.Uuid
  enabled   Boolean @default(true)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  shift     CourierShift?
  commands  CourierAvailabilityCommand[]
  labOffers DispatchLabOffer[]
  labCommands DispatchLabCommand[]
  labEvents DispatchLabOutbox[]

  @@schema("app")
}

model DispatchLabScenario {
  id String @id @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  offers DispatchLabOffer[]
  events DispatchLabOutbox[]

  @@schema("app")
}

model DispatchLabOffer {
  id String @id @db.Uuid
  syntheticDeliveryRef String @db.Uuid
  courierId String
  status String @default("offered")
  version Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
  changedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  scenario DispatchLabScenario @relation(fields: [syntheticDeliveryRef], references: [id], onDelete: Restrict, onUpdate: NoAction)
  courier Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignment DispatchLabAssignment?

  @@unique([id, syntheticDeliveryRef, courierId])
  @@index([courierId], map: "dispatch_lab_offer_courier")
  @@schema("app")
}

model DispatchLabAssignment {
  id String @id @db.Uuid
  offerId String @unique @db.Uuid
  syntheticDeliveryRef String @db.Uuid
  courierId String
  status String @default("active")
  version Int @default(1)
  changedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  offer DispatchLabOffer @relation(fields: [offerId, syntheticDeliveryRef, courierId], references: [id, syntheticDeliveryRef, courierId], onDelete: Restrict, onUpdate: NoAction)

  // Partial active indexes are owned by SQL migration, not ordinary unique indexes.
  @@unique([offerId, syntheticDeliveryRef, courierId])
  @@schema("app")
}

model DispatchLabCommand {
  courierId String
  idempotencyKeyHash String @db.Char(64)
  requestHash String @db.Char(64)
  receipt Json
  courier Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([courierId, idempotencyKeyHash])
  @@schema("app")
}

model DispatchLabOutbox {
  id String @id @db.Uuid
  courierId String
  syntheticDeliveryRef String @db.Uuid
  aggregateKind String
  aggregateId String @db.Uuid
  aggregateVersion Int
  eventType String
  occurredAt DateTime @db.Timestamptz(3)
  courier Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  scenario DispatchLabScenario @relation(fields: [syntheticDeliveryRef], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([aggregateKind, aggregateId, aggregateVersion])
  @@index([courierId], map: "dispatch_lab_outbox_courier")
  @@schema("app")
}

model CourierShift {
  courierId String @id
  status    String @default("offline")
  version   Int @default(1)
  changedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@schema("app")
}

model CourierAvailabilityCommand {
  courierId          String
  idempotencyKeyHash String @db.Char(64)
  requestHash        String @db.Char(64)
  status             String
  version            Int
  changedAt          DateTime @db.Timestamptz(3)
  courier            Courier @relation(fields: [courierId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([courierId, idempotencyKeyHash])
  @@schema("app")
}

model Merchant {
  id          String       @id
  name        String
  enabled     Boolean      @default(true)
  branches    Branch[]
  memberships Membership[]

  @@schema("app")
}

model Branch {
  id          String         @id
  merchantId  String
  name        String
  enabled     Boolean        @default(true)
  latitude    Float
  longitude   Float
  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  quotes      PricingQuote[]
  deliveries  Delivery[]
  privateLocations PrivateLocationEnvelope[]

  @@unique([id, merchantId])
  @@index([merchantId])
  @@schema("app")
}

model Membership {
  id         String   @id
  subjectId  String   @db.Uuid
  merchantId String
  branchId   String
  enabled    Boolean  @default(true)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch     Branch   @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([subjectId, branchId])
  @@index([branchId, merchantId])
  @@index([merchantId])
  @@schema("app")
}

model PricingQuote {
  id                  String    @id
  subjectId           String    @db.Uuid
  merchantId          String
  branchId            String
  request             Json
  amountMinor         Int
  baseAmountMinor     Int
  distanceAmountMinor Int
  currency            String    @default("MXN")
  expiresAt           DateTime  @db.Timestamptz(3)
  rateVersion         String
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  branch              Branch    @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  delivery            Delivery?

  @@unique([id, branchId, merchantId])
  @@index([branchId, merchantId, createdAt])
  @@index([subjectId])
  @@schema("app")
}

model Delivery {
  publicReference DeliveryPublicReference?
  id                  String       @id @default(uuid())
  subjectId           String       @db.Uuid
  merchantId          String
  branchId            String
  quoteId             String       @unique
  status              String       @default("requested")
  version             Int          @default(1)
  amountMinor         Int
  baseAmountMinor     Int
  distanceAmountMinor Int
  currency            String
  rateVersion         String
  routeSnapshot       Json
  idempotencyKeyHash  String       @db.Char(64)
  requestHash         String       @db.Char(64)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  branch              Branch       @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  quote               PricingQuote @relation(fields: [quoteId, branchId, merchantId], references: [id, branchId, merchantId], onDelete: Restrict)

  @@unique([subjectId, branchId, idempotencyKeyHash])
  @@unique([quoteId, branchId, merchantId])
  @@index([branchId, merchantId, createdAt])
  @@schema("app")
}

model DeliveryPublicReference {
  deliveryId String @id
  publicReference String @unique
  issuedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@schema("app")
}

model PrivateLocationEnvelope {
  id             String   @id @db.Uuid
  subjectId      String   @db.Uuid
  merchantId     String
  branchId       String
  requestId      String   @db.Uuid
  version        Int      @default(1)
  policyId       String
  expiresAt      DateTime @db.Timestamptz(3)
  keyRef         String   @unique @db.Uuid
  iv             Bytes
  tag            Bytes
  ciphertext     Bytes
  state          String   @default("active")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  keyDestroyedAt DateTime? @db.Timestamptz(3)
  branch         Branch   @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([subjectId, branchId, requestId])
  @@index([branchId, merchantId])
  @@schema("app")
}
