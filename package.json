{
  "name": "delivery-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test packages/pricing/tests/*.test.ts packages/contracts/tests/*.test.ts packages/branding/tests/*.test.ts packages/design-tokens/tests/*.test.ts apps/api/tests/*.test.ts scripts/tests/*.test.mjs scripts/maps/tests/*.test.ts && pnpm --filter @delivery/ui-web test && pnpm --filter @delivery/merchant-web test && pnpm --filter @delivery/courier-mobile test",
    "check:lines": "node scripts/check-source-lengths.mjs",
    "check": "pnpm run db:generate && pnpm run db:validate && pnpm run check:lines && pnpm run typecheck && pnpm run typecheck:ui && pnpm run test",
    "typecheck": "tsc --project tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "node --env-file=.env.local node_modules/prisma/build/index.js migrate status",
    "local:up": "node scripts/local/up.mjs",
    "local:seed": "node --experimental-strip-types scripts/local/seed.ts",
    "local:quote": "node --experimental-strip-types scripts/local/quote.ts",
    "local:status": "node scripts/local/operations.mjs status",
    "local:stop": "node scripts/local/operations.mjs stop",
    "test:integration": "node --experimental-strip-types scripts/local/test-integration.ts",
    "gallery": "pnpm --filter @delivery/ui-web gallery",
    "typecheck:ui": "pnpm --filter @delivery/ui-web typecheck && pnpm --filter @delivery/merchant-web typecheck && pnpm --filter @delivery/courier-mobile typecheck",
    "gallery:build": "pnpm --filter @delivery/ui-web gallery:build",
    "merchant": "pnpm --filter @delivery/merchant-web dev",
    "merchant:demo": "pnpm --filter @delivery/merchant-web dev:demo",
    "merchant:build": "pnpm --filter @delivery/merchant-web build",
    "maps:evaluate": "node --experimental-strip-types scripts/maps/cli.ts",
    "courier": "pnpm --filter @delivery/courier-mobile start",
    "courier:web": "pnpm --filter @delivery/courier-mobile web",
    "courier:export": "pnpm --filter @delivery/courier-mobile export:android && pnpm --filter @delivery/courier-mobile export:web",
    "courier:local-smoke": "node --experimental-strip-types apps/courier-mobile/scripts/local-smoke.mts",
    "gallery:geometry": "pnpm --filter @delivery/ui-web gallery:geometry",
    "merchant:geometry": "pnpm --filter @delivery/merchant-web geometry:shell",
    "stripe:sandbox:history": "node --experimental-strip-types scripts/local/stripe-history.ts",
    "stripe:sandbox:fixture": "node --experimental-strip-types scripts/local/stripe-fixture.ts",
    "stripe:sandbox:preflight": "node --experimental-strip-types scripts/local/stripe-preflight.ts",
    "stripe:sandbox:trial": "node --experimental-strip-types scripts/local/stripe-trial.ts"
  },
  "devDependencies": {
    "@prisma/client": "7.10.1",
    "@types/node": "22.19.15",
    "prisma": "7.10.1",
    "supabase": "2.121.0",
    "turbo": "2.5.6",
    "typescript": "5.8.3"
  }
}
