{
  "name": "delivery-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test packages/pricing/tests/*.test.ts packages/contracts/tests/*.test.ts apps/api/tests/*.test.ts scripts/tests/*.test.mjs",
    "check:lines": "node scripts/check-source-lengths.mjs",
    "check": "pnpm run db:generate && pnpm run db:validate && pnpm run check:lines && pnpm run typecheck && pnpm run test",
    "typecheck": "tsc --project tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "node --env-file=.env.local node_modules/prisma/build/index.js migrate status",
    "local:up": "node scripts/local/up.mjs",
    "local:seed": "node --experimental-strip-types scripts/local/seed.ts",
    "local:quote": "node --experimental-strip-types scripts/local/quote.ts",
    "local:status": "node scripts/local/operations.mjs status",
    "local:stop": "node scripts/local/operations.mjs stop",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 apps/api/integration/*.test.ts"
  },
  "devDependencies": {
    "@prisma/client": "7.10.1",
    "@types/node": "22.19.15",
    "prisma": "7.10.1",
    "supabase": "2.121.0",
    "turbo": "2.5.6",
    "typescript": "5.8.3"
  }
}
