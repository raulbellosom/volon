{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delivery:contracts:delivery-quote:v1",
  "title": "Solicitud de cotización logística v1 (experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branchId",
    "pickup",
    "dropoff",
    "serviceType"
  ],
  "properties": {
    "branchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "pickup": {
      "$ref": "#/$defs/point"
    },
    "dropoff": {
      "$ref": "#/$defs/point"
    },
    "serviceType": {
      "const": "local_delivery"
    },
    "destination": {
      "$ref": "#/$defs/destination"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quoteId",
        "expiresAt",
        "currency",
        "amountMinor",
        "lines",
        "coverage"
      ],
      "properties": {
        "quoteId": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "currency": {
          "const": "MXN"
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage": {
          "const": "eligible"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "amountMinor"
            ],
            "properties": {
              "code": {
                "enum": [
                  "base_delivery",
                  "distance_delivery"
                ]
              },
              "amountMinor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressLine",
        "source",
        "verification"
      ],
      "properties": {
        "addressLine": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\uD800-\\uDFFF\\u2028\\u2029])\\S(?:.*\\S)?$",
          "maxLength": 240
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\uD800-\\uDFFF\\u2028\\u2029])\\S(?:.*\\S)?$",
          "maxLength": 500
        },
        "source": {
          "const": "synthetic"
        },
        "verification": {
          "const": "unverified"
        }
      }
    }
  }
}
